# Copy to deploy/.env; never commit .env or place it in the image.
# Public standard HTTPS port; exact origin, no path or trailing slash.
VW_PUBLIC_ORIGIN=https://studio.example.com
# Generate independently: openssl rand -hex 32
VW_GATEWAY_SECRET=
# Each team account has its own password. Store only a bcrypt hash here.
VW_AUTH_USER=editor
# Paste caddy hash-password output between single quotes to preserve its $ signs.
VW_AUTH_HASH=''
VW_VOLUME_NAME=virtualworld-workspace

# Shared workspace admission limits, not per-user quotas.
VW_MAX_PENDING_GENERATIONS=8
VW_MAX_AGENT_REQUESTS=2
VW_MAX_EXPORTS=1
VW_MAX_EXPORT_MIB=256

# Optional server-only provider credentials; leave blank for unconfigured AI.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
TRIPO_BASE_URL=https://openapi.tripo3d.ai/v3
TRIPO_MODEL=v3.1-20260211
TRIPO_API_KEY=
