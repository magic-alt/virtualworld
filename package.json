{
  "name": "ai-3d-world-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "generators/*"
  ],
  "scripts": {
    "predev": "npm run fixtures",
    "prebuild": "npm run fixtures && npm run notices",
    "pretest": "npm run fixtures",
    "format": "prettier --write apps packages generators tests scripts worlds *.ts *.json",
    "format:check": "prettier --check apps packages generators tests scripts worlds *.ts *.json",
    "dev": "concurrently -k -n api,web \"tsx watch apps/web/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && vite build --config vite.player.config.ts",
    "start": "tsx apps/web/server/index.ts",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "test:browser": "node tests/e2e/browser-check.mjs && node --import tsx tests/e2e/world-experience-check.mjs",
    "test:showcases": "node tests/e2e/showcases-check.mjs",
    "test:harmonic": "node tests/e2e/harmonic-controls-check.mjs",
    "fixtures": "tsx scripts/fixtures.ts",
    "notices": "tsx scripts/notices.ts",
    "world:generate": "tsx generators/scene-builder/src/cli.ts generate",
    "world:validate": "tsx generators/scene-builder/src/cli.ts validate",
    "asset:optimize": "tsx generators/scene-builder/src/cli.ts optimize",
    "world:cli": "tsx generators/scene-builder/src/cli.ts",
    "demos:build": "tsx scripts/demos.ts build",
    "demos:validate": "tsx scripts/demos.ts validate"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@sparkjsdev/spark": "2.3.1",
    "dotenv": "17.2.3",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "gltf-validator": "2.0.0-dev.3.10",
    "lucide-react": "0.468.0",
    "occt-import-js": "0.0.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.1.0",
    "concurrently": "9.2.5",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
