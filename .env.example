# Compatible Chat Completions endpoint; server-side only. Never use VITE_ for secrets.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
PORT=3001
# Defaults are local-only. Hosted mode requires the authenticated TLS gateway
# and durable volume described in docs/deployment.md / deploy/.env.example.
VW_SERVER_MODE=local
VW_HOST=127.0.0.1
# Leave empty to preserve the local layout. Hosted mode requires a durable path.
VW_DATA_ROOT=
# Required only in hosted mode: exact HTTPS origin, no trailing slash.
VW_PUBLIC_ORIGIN=
# Use 32..256 random URL-safe characters; never expose this header to browsers.
VW_GATEWAY_SECRET=
# Admission limits: active + queued generation jobs, concurrent agent calls,
# concurrent exports, logical uncompressed ZIP contents in MiB (not process RAM).
VW_MAX_PENDING_GENERATIONS=8
VW_MAX_AGENT_REQUESTS=2
VW_MAX_EXPORTS=1
VW_MAX_EXPORT_MIB=256
# Server/CLI only. Official Tripo v3; paid tasks require explicit selection.
TRIPO_BASE_URL=https://openapi.tripo3d.ai/v3
TRIPO_MODEL=v3.1-20260211
TRIPO_API_KEY=
# Optional fixed batch processor, e.g. C:/Program Files/Blender Foundation/Blender 4.5/blender.exe
BLENDER_BIN=
# Optional native player deployments, one URL per saved scene and engine.
# The revision must match the exported SceneSpec. Set default:true only after
# building and verifying the real Unity Web / Unreal Pixel Streaming player.
# VW_ENGINE_RUNTIMES=[{"engine":"unity","sceneId":"little-prince-desert","revision":0,"url":"http://127.0.0.1:8080/","default":true}]
